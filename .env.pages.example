# =============================================================================
# Cloudflare Pages — csvhospital.com (static site · Production env map)
# =============================================================================
# Pages deploys ONLY the Vite `dist/` output — no /functions worker.
# Support triage API stays on local Express (`npm run dev:server`) or a
# separate backend; do not re-add a repo-root functions/ directory.
#
# Copy into: Dashboard → Workers & Pages → (project slug may still be the
# historical CF id `facelessblur`) → Settings → Environment variables →
# Production. VITE_* keys need Build scope (baked in at `npm run build`).
# =============================================================================

# --- Build-time (Vite client) — set "Build" availability ---
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
VITE_FREEMIUS_STORE_ID=
VITE_FREEMIUS_PRODUCT_ID=36475
VITE_FREEMIUS_PUBLIC_KEY=pk_1411029c3e32680a04780cd82936a
VITE_FREEMIUS_PLAN_ID=60396
VITE_FREEMIUS_PLAN_ID_1=
VITE_FREEMIUS_PLAN_ID_5=
VITE_FREEMIUS_PLAN_ID_15=
VITE_FREEMIUS_PLAN_ID_25=
VITE_FREEMIUS_PLAN_ID_50=
VITE_FREEMIUS_PLAN_ID_75=
VITE_FREEMIUS_PLAN_ID_100=
# Exact pricing_id per tier (overrides are optional — code ships matching defaults)
VITE_FREEMIUS_PRICING_ID_1=80492
VITE_FREEMIUS_PRICING_ID_5=80493
VITE_FREEMIUS_PRICING_ID_15=80494
VITE_FREEMIUS_PRICING_ID_25=80495
VITE_FREEMIUS_PRICING_ID_50=80496
VITE_FREEMIUS_PRICING_ID_75=80498
VITE_FREEMIUS_PRICING_ID_100=80499
# Live production: keep false. Set true only for Freemius sandbox/test deploys.
VITE_FREEMIUS_MOCK=false
VITE_FREEMIUS_SANDBOX=false
SITE_URL=https://csvhospital.com

# --- Public site ---
CLIENT_URL=https://csvhospital.com
NODE_ENV=production

# Optional: Discord Worker / Express-only secrets are NOT required for the
# static Pages deploy. Keep those in local .env for `npm run discord:deploy`
# and `npm run dev:server`.
