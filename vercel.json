{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/hospital",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/hospital/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cure",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/2",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cyber-cube-heaven",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cyber-cube-heaven/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
