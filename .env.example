# Stripe (https://dashboard.stripe.com/apikeys)
# Production (facelessblur.com): use LIVE keys — sk_live_... / pk_live_...
# Local development only: you may use Stripe test keys — sk_test_... / pk_test_...
# Never commit real values. Never hardcode secrets in source.
STRIPE_SECRET_KEY=sk_live_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Optional: also returned by create-payment-intent when set server-side
# STRIPE_PUBLISHABLE_KEY=pk_live_...

# Freemius Checkout overlay (Unlock Discharge / Purchase Authorized User Access)
# Product keys are the same for sandbox and live (unlike Stripe sk_test / sk_live).
# From Freemius Dashboard → Product → Keys / Plans → Get Checkout → Overlay
VITE_FREEMIUS_PRODUCT_ID=34967
VITE_FREEMIUS_PLAN_ID=57500
VITE_FREEMIUS_PUBLIC_KEY=pk_96bd363d5fbf016bebe4795ecda42
# Server-only — Product → API / Keys → Secret Key (never VITE_ / never commit real value)
FREEMIUS_SECRET_KEY=sk_...
# Live sales: false (omit sandbox token — real charges). Sandbox testing: true
FREEMIUS_SANDBOX=false
VITE_FREEMIUS_SANDBOX=false

# One-time Price ID (Products → copy Price ID) — use the live-mode price in production
STRIPE_PRICE_ID=price_...

# Public app URL — used for Stripe success/cancel redirects
# Local:  https://localhost:5200
# Live:   https://facelessblur.com
CLIENT_URL=https://facelessblur.com

# HMAC secret for signed unlock cookies (min 16 chars; not the placeholder)
UNLOCK_SECRET=change-me-to-a-long-random-string

# Stripe webhook signing secret (Dashboard → Developers → Webhooks)
# Local: stripe listen --forward-to localhost:4242/api/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Access-layer rate limits (optional; defaults shown)
RATE_LIMIT_CHECKOUT=10
RATE_LIMIT_VERIFY=30
RATE_LIMIT_UNLOCK_STATUS=60
RATE_LIMIT_TRIAGE=20
RATE_LIMIT_WINDOW_MS=60000

# Faceless Guardian — security monitoring
# Private Discord webhook for startup greeting + anomaly alerts (optional fallback)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Requests/min per IP before THROTTLE (optional; default 30)
GUARDIAN_VELOCITY_LIMIT=30

# Faceless Manager — operations lead AI (admin channel)
# Prefer a dedicated webhook so Manager updates stay on a private admin channel (fallback)
MANAGER_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Routine check-in interval in ms (default 6h; set 0 to disable)
MANAGER_CHECKIN_INTERVAL_MS=21600000

# Two-way Discord bot (preferred over webhooks)
# Discord Developer Portal → Bot → Reset Token; enable MESSAGE CONTENT INTENT
# Invite bot with: View Channel, Send Messages, Read Message History, Manage Webhooks
# (Manage Webhooks lets Manager / Guardian / Frontline speak as distinct identities)
DISCORD_BOT_TOKEN=your_discord_bot_token
# Application ID (Developer Portal → General Information) — needed for slash commands + Worker follow-ups
DISCORD_APPLICATION_ID=123456789012345678
# Public Key (same page) — Worker uses this for Ed25519 signature verification (npm run discord:deploy)
DISCORD_PUBLIC_KEY=your_discord_application_public_key_hex
# Right-click command channel → Copy Channel ID (Developer Mode on)
DISCORD_COMMAND_CHANNEL_ID=123456789012345678
# Agent notifications channel — automated alerts / health / status only (no chat, no gauntlet)
# Create a separate channel (e.g. #agent-notifications), invite the bot, paste its channel ID
DISCORD_NOTIFY_CHANNEL_ID=123456789012345678
# Frontline CS logs — transcripts, triage notes, escalations (isolated from command + notifications)
DISCORD_FRONTLINE_LOGS_CHANNEL_ID=123456789012345678
# Optional: lock commands to Tom's Discord user ID only
# DISCORD_OWNER_USER_ID=123456789012345678
# Verbose Gateway / messageCreate traces (default on outside production; set 0 to silence)
# DISCORD_DEBUG=1
# Rotate cyberpunk presence every N ms (default 300000 = 5 min)
# DISCORD_PRESENCE_INTERVAL_MS=300000
#
# Production (no Gateway timeouts): Cloudflare Worker interactions
#   npm run discord:deploy     → compile + deploy Worker + sync secrets from this .env
#   npm run discord:commands   → register /ask /frontline /bridge /ping
#   Set Interactions Endpoint URL to the Worker URL (or facelessblur.com/api/discord/interactions)
# Local channel chat still: npm run discord:bot

# Support triage / Frontline AI — Cloudflare Workers AI (native /ai/run)
# POST https://api.cloudflare.com/client/v4/accounts/{account_id}/ai/run/@cf/meta/llama-3.1-8b-instruct
# Also used by Wrangler (`npm run discord:deploy`) — use modern names, not CF_*
AI_MODEL=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
# Optional full override:
# CF_AI_RUN_URL=https://api.cloudflare.com/client/v4/accounts/ACCOUNT_ID/ai/run/@cf/meta/llama-3.1-8b-instruct
TRIAGE_CONFIDENCE_THRESHOLD=0.8

# Support email (Resend) — needs_human escalations
SUPPORT_EMAIL=tcardaro0144@gmail.com
# Verified sender in Resend
SUPPORT_FROM_EMAIL=CSV Hospital Support <onboarding@resend.dev>
RESEND_API_KEY=re_...

# Make.com scenario webhook — CSV Hospital outbound data triggers
# (order.pending, order.paid, support.needs_human, support.handoff)
# Dashboard → Webhooks → Custom webhook → Copy URL (hook.us2.make.com / hook.make.com)
MAKE_WEBHOOK_URL=https://hook.us2.make.com/your_webhook_path

# Support handoffs: visitor email + unanswered question are emailed to SUPPORT_EMAIL
# via Resend and also posted to MAKE_WEBHOOK_URL as event "support.handoff".

# Local Express API only (optional; defaults to 4242)
PORT=4242

# =============================================================================
# Cloudflare Pages (project: facelessblur) — production deploy
# =============================================================================
# Full Production env map for the dashboard: see .env.pages.example
# CLI deploy (token needs Pages:Edit):
#   npm run deploy:pages
# Git-connected builds: push to main after linking tcardaro0144-stack/facelessblur
# Custom domain: attach facelessblur.com on the facelessblur Pages project
#   (remove it from legacy csv-hospital if still attached there).
# Sitemap base URL at build time:
SITE_URL=https://facelessblur.com
